{
  "name": "open-iptv",
  "version": "1.10.0",
  "description": "IPTV player for Samsung Tizen TVs with experimental shared web app ports",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "icon": "node scripts/icon.mjs",
    "package": "./scripts/package.sh",
    "ports:package": "node scripts/tv-ports.mjs all --ipk",
    "ports:smoke": "node scripts/tv/ports-smoke.mjs",
    "package:webos": "npm run build && node scripts/tv-ports.mjs webos --ipk",
    "package:hosted": "npm run build && node scripts/tv-ports.mjs hosted",
    "package:vega": "npm run build && node scripts/tv-ports.mjs vega",
    "deploy:webos": "node scripts/webos-install.mjs",
    "simulator": "npm run package && arch -x86_64 \"$HOME/.tizen-extension-platform/server/sdktools/data/tools/sec-tv-simulator/nwjs.app/Contents/MacOS/nwjs\" --platform samsung-tv --tizentvversion 10.0 --resolution 1920x1080 --file \"$PWD/build/OpenIPTV.wgt\"",
    "deploy": "./scripts/deploy.sh",
    "tv": "node scripts/tv/sim.mjs",
    "tv:bench": "node scripts/tv/sim.mjs --bench",
    "tv:calibrate": "node scripts/tv/calibrate.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "tv:video": "node scripts/tv/sim.mjs --video",
    "tv:floor": "node scripts/tv/sim.mjs --floor",
    "tv:bench:floor": "node scripts/tv/sim.mjs --floor --bench",
    "tv:quick": "node scripts/tv/sim.mjs --floor --bench --quick",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test:watch": "vitest",
    "tv:gap": "node scripts/tv/gap-parity.mjs",
    "tv:engines": "node scripts/tv/engine-parity.mjs",
    "tv:budget": "node scripts/tv/sim.mjs --floor --bench --budget",
    "tv:on-set": "node scripts/tv/on-set.mjs",
    "wasm:check": "node scripts/wasm-check.mjs",
    "wasm:sums": "node scripts/wasm-check.mjs --write",
    "store:assets": "node scripts/store-assets.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "keywords": [
    "iptv",
    "m3u",
    "hls",
    "tizen",
    "samsung-tv",
    "smart-tv",
    "television",
    "player"
  ],
  "author": "Shayan Khaksar",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "hls.js": "1.7.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayanline/OpenIPTV.git"
  },
  "bugs": {
    "url": "https://github.com/shayanline/OpenIPTV/issues"
  },
  "homepage": "https://github.com/shayanline/OpenIPTV#readme"
}
