{
  "name": "open-iptv",
  "version": "1.3.0",
  "description": "IPTV player for Samsung Tizen TVs",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "icon": "node scripts/icon.mjs",
    "package": "./scripts/package.sh",
    "deploy": "./scripts/deploy.sh",
    "tv": "node scripts/tv/sim.mjs",
    "tv:bench": "node scripts/tv/sim.mjs --bench",
    "tv:calibrate": "node scripts/tv/calibrate.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "tv:video": "node scripts/tv/sim.mjs --video",
    "tv:floor": "node scripts/tv/sim.mjs --floor",
    "tv:bench:floor": "node scripts/tv/sim.mjs --floor --bench",
    "tv:quick": "node scripts/tv/sim.mjs --floor --bench --quick",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "test:watch": "vitest",
    "tv:gap": "node scripts/tv/gap-parity.mjs",
    "tv:engines": "node scripts/tv/engine-parity.mjs",
    "tv:budget": "node scripts/tv/sim.mjs --floor --bench --budget",
    "tv:on-set": "node scripts/tv/on-set.mjs",
    "wasm:check": "node scripts/wasm-check.mjs",
    "wasm:sums": "node scripts/wasm-check.mjs --write",
    "store:assets": "node scripts/store-assets.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "keywords": [
    "iptv",
    "m3u",
    "hls",
    "tizen",
    "samsung-tv",
    "smart-tv",
    "television",
    "player"
  ],
  "author": "Shayan Khaksar",
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "hls.js": "1.7.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shayanline/OpenIPTV.git"
  },
  "bugs": {
    "url": "https://github.com/shayanline/OpenIPTV/issues"
  },
  "homepage": "https://github.com/shayanline/OpenIPTV#readme"
}
