# `npm version` writes the tag as well as package.json, and its default prefix is `v`. The release
# workflow triggers on a bare version tag instead, because Samsung takes `major.minor.micro` and
# nothing else, so a prefix would have to be stripped everywhere the tag is compared with the
# version. Without this line the tag and the trigger silently stop matching and a release does not
# run at all, which looks exactly like nothing happening.
tag-version-prefix=
